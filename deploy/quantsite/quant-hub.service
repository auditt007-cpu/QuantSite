# QuantSite attribution hub + daily LLM pipeline
# Install: sudo bash scripts/install_hub.sh

[Unit]
Description=QuantSite FastAPI + Telegram attribution hub
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/quantsite
EnvironmentFile=-/root/quantsite/.env
ExecStart=/usr/bin/python3 /root/quantsite/bot_server.py
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
